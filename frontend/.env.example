# API base URL for the manga backend (full base URL including /api/v1 if applicable)
# Local development (Laravel on port 8000):
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Remote API (manga-apis.fatelight.org):
# VITE_API_BASE_URL=https://manga-apis.fatelight.org/api/v1
#
# If unset, defaults to http://localhost:8000/api/v1
VITE_API_BASE_URL=https://manga-apis.fatelight.org/api/v1

# Optional: Google AdSense slot IDs (create ad units in AdSense to get slot IDs)
# VITE_ADSENSE_SLOT_HOME=1234567890
# VITE_ADSENSE_SLOT_LEFT=   / VITE_ADSENSE_SLOT_RIGHT=  (desktop side columns)
# VITE_ADSENSE_SLOT_CONTENT=  (between card sections, every 12 cards)
VITE_ADSENSE_SLOT_INFEED=9627682077

# Contact Us page email (optional)
VITE_CONTACT_EMAIL=info@fatelight.org
