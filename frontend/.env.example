# API base URL for the manga backend (full base URL including /api/v1)
# Production (default if unset):
# VITE_API_BASE_URL=https://manga-apis.fatelight.org/api/v1
# Local Laravel:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=https://manga-apis.fatelight.org/api/v1

# Contact Us page email (optional)
VITE_CONTACT_EMAIL=info@fatelight.org
